# master key: locks /v1 and the admin console. If unset, a random key is
# generated on first run, saved in the db, and printed to the log.
DEVIN_PROXY_KEY=

# where the SQLite db lives inside the container (keep on ./data)
# holds: request log, API keys, account pool, session pins, stored responses
DEVIN_PROXY_DB=/data/devin-proxy.db

# request-log retention cap
DEVIN_PROXY_MAX_ROWS=50000

# optional: seed an account from a token file instead of OAuth in /admin
# (mount the file into the container first, e.g. ./devin-token.txt:/run/token)
# DEVIN_SESSION_TOKEN_FILE=/run/token
