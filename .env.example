# master key: locks /v1 and the admin console. Strongly recommended.
DEVIN_PROXY_KEY=

# where the SQLite db lives inside the container (keep on the volume)
DEVIN_PROXY_DB=/data/devin-proxy.db

# request-log retention cap
DEVIN_PROXY_MAX_ROWS=50000

# NOTE: the Devin session token goes in ./devin-token.txt (mounted as a
# docker secret), NOT here — env_file interpolation would mangle its '$'.
