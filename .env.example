# master key: locks /v1 and the admin console. If unset, a random key is
# generated on first run, saved in the db, and printed to the log.
DEVIN_PROXY_KEY=

# where the SQLite db lives inside the container (keep on ./data)
# holds: request log, API keys, account pool, session pins, stored responses
DEVIN_PROXY_DB=/data/devin-proxy.db

# request-log retention cap
DEVIN_PROXY_MAX_ROWS=50000

# disk-space resilience: the proxy keeps serving requests even if the
# volume backing the db fills up completely. A background check prunes
# old history + VACUUMs once free space drops below this (MB); a small
# sacrificial "reserve" file (also MB) is kept on disk so there's always
# a little room to write into for that emergency cleanup, even at 0 free
# bytes. Manual cleanup is also available in the admin UI ("释放磁盘空间").
# DEVIN_PROXY_MIN_FREE_MB=128
# DEVIN_PROXY_RESERVE_MB=8

# upstream read timeout (seconds) — Devin's agent stream can pause for a
# long while between deltas when the server runs tools; too low a value
# makes long tool runs look like a dropped stream (断流)
DEVIN_PROXY_READ_TIMEOUT=1800

# per-request debug log caps (chars): raw request body, upstream event
# timeline and every outbound SSE frame are stored per request row
DEVIN_PROXY_LOG_CAP=200000

# full-fidelity wire capture (untruncated): inbound request bytes +
# headers, the exact upstream protobuf, every upstream frame/trailer and
# every outbound SSE frame — stored gzipped per request and included in
# the admin "导出诊断包" zip. 0 disables capture entirely.
# DEVIN_PROXY_CAPTURE=1

# per-request capture size bound (bytes, uncompressed measure)
# DEVIN_PROXY_CAP_MAX=33554432

# retention: failure captures are kept forever; captures of successful
# requests are pruned to the newest N (a healthy stream can be megabytes)
# DEVIN_PROXY_CAP_KEEP=300

# model catalog: seconds before the upstream GetCliModelConfigs snapshot
# is re-fetched in the background (the list is remote-fetched, not builtin)
DEVIN_PROXY_MODELS_TTL=3600

# optional extra model source: a JSON URL merged into the catalog
# (["uid",...] | [{"uid"|"id","label",...},...] | {"models":[...]})
# DEVIN_PROXY_MODELS_URL=

# admin login brute-force limit: N failed attempts per IP within WIN
# seconds returns 429 (default 5 / 300)
# DEVIN_PROXY_LOGIN_MAX=5
# DEVIN_PROXY_LOGIN_WIN=300

# optional: seed an account from a token file instead of OAuth in /admin
# (mount the file into the container first, e.g. ./devin-token.txt:/run/token)
# DEVIN_SESSION_TOKEN_FILE=/run/token
